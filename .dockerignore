# ── 密钥与环境文件（绝不进镜像） ──
.env
.env.*
!.env.example

# ── 版本控制与本地元数据 ──
.git/
.gitignore
.hermes/
.zcode/

# ── 手工备份与历史快照（改用 vm.sh / git tag，一律不进镜像） ──
versions/
*.bak
*.bak.*
*.bak_*
*.orig
*.pyc
*.pyo

# ── 运行时与日志 ──
logs/
*.log
*.pid

# ── 备份产物 ──
*.tgz
*.tar.gz
backup/
/backup/

# ── Python 缓存与构建产物 ──
__pycache__/
*.egg-info/
dist/
build/

# ── 编辑器/系统 ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── 文档（无需进运行时镜像） ──
*.md
