# VaultDrive / resource_web 环境变量模板
# 复制为 .env 后填入真实值：  cp .env.example .env
# 警告：.env 含密钥，严禁提交；本文件只允许放占位符。
#
# 注：不在 .env 中出现的键，会回落到数据库 settings 表的同名记录
#     （如 admin_pass / tmdb_api_key / telegram_bot_token），改配置前先确认优先级。

# ---------- 基础 ----------
SECRET_KEY=CHANGE_ME_random_32_bytes_hex
ADMIN_USER=CHANGE_ME_admin_username
ADMIN_PASS=CHANGE_ME_strong_admin_password
TZ=Asia/Shanghai
SESSION_COOKIE_NAME=CHANGE_ME_cookie_name

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME_db_user
DB_PASSWORD=CHANGE_ME_db_password
DB_NAME=pan_resource

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------- 第三方 ----------
TMDB_API_KEY=CHANGE_ME_tmdb_api_key
TRAKT_CLIENT_ID=CHANGE_ME_trakt_client_id
SEARCH_API=CHANGE_ME_search_api_endpoint

# ---------- GitHub OAuth（可选） ----------
GITHUB_CLIENT_ID=CHANGE_ME_github_client_id
GITHUB_CLIENT_SECRET=CHANGE_ME_github_client_secret
GITHUB_REDIRECT_URI=https://your-domain.example/login/github/callback
# GITHUB_HTTP_PROXY=

# ---------- Telegram 登录 ----------
TELEGRAM_BOT_TOKEN=CHANGE_ME_botfather_token
TELEGRAM_BOT_USERNAME=CHANGE_ME_bot_username
TELEGRAM_AUTH_MAX_AGE=300
TELEGRAM_REQUIRED_CHAT=CHANGE_ME_channel_or_chat
TELEGRAM_CHANNEL=CHANGE_ME_channel
TELEGRAM_SEARCH_BOT=CHANGE_ME_search_bot_username
# TELEGRAM_WEBHOOK_BASE=https://your-domain.example

# ---------- 邮件（注册/找回密码） ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM_NAME=VaultDrive

# ---------- 代理（可选） ----------
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
