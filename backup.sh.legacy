#!/bin/bash
# ⚠️ 已弃用（DEPRECATED）——请使用 scripts/backup.sh
#
# 本脚本经审计确认从未成功备份过任何数据，保留仅供追溯。已知缺陷：
#   1. `docker exec resource_web mysqldump` —— 应用容器内没有 mysqldump，该行必然失败
#   2. 失败被 `2>/dev/null || true` 吞掉，始终打印"备份完成"
#   3. /backup/resource_web 无 volume 挂载，即使成功也写进容器内部，删容器即丢
#   4. 只备份 8/22 张表，漏掉 point_logs / watchlist / subscriptions / announcements 等 14 张
#   5. `-a "${REDIS_PASSWORD}"` 但该变量未设置（Redis 实际无密码）
#   6. `find -mtime +7 -delete` 无 -name 过滤，会删掉 backup.log 自身
#   7. 从未接入任何 cron / systemd timer，根本不在运行
#
# 替代方案：scripts/backup.sh（全库 + Redis + 配置，含校验与恢复演练）
#   crontab: 30 3 * * * cd /vol1/1000/docker/resource_web && bash scripts/backup.sh
set -euo pipefail
echo "此脚本已弃用，不再执行任何操作。请使用 scripts/backup.sh" >&2
exit 1
